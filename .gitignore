# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/dist

# Electron
*.exe

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
/server/.env
/breeding-app-backend/.env
/breeding-app-lab/.env.e2e.local
/breeding-app-lab/playwright/.auth
/breeding-app-lab/playwright-report
/breeding-app-lab/test-results
/breeding-app-breeder/.env.e2e.local
/breeding-app-breeder/playwright/.auth
/breeding-app-breeder/playwright-report
/breeding-app-breeder/test-results
/server/node_modules
/server/dist
.codex-*.log
/server/*.log
/.tools

# Android signing secrets
*.keystore
*.jks
# Unanchored: a leading path component would pin these to the repo root, and the
# sub-apps carry their own Capacitor projects (breeding-app-lab/android/, and
# breeding-app-breeder/android/). `android/key.properties` left a lab or breeder
# key.properties -- storePassword and keyPassword in cleartext -- tracked in a
# public repository.
**/key.properties
**/android/app/*.keystore
**/android/app/*.jks

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Binaries and archives — never commit these
*.apk
*.zip
*.tar.gz
node-v*/
node_installer/

# Local dev server logs and Vite dep cache
/.tmp-dev-server
/.vite

# Generated by scripts/species/buildPreview.mjs for eyeballing the species tables
/species-preview.html

# Claude Code machine-local state. `.claude/settings.json` is the shared project
# config and stays tracked; this is the per-machine half -- an allowlist that
# grows every session, carrying absolute paths and local database credentials.
# It was tracked in a public repository until 2026-09-16.
.claude/settings.local.json
.claude/skills/

# Written by the impeccable design skill while it works. `.impeccable/config.json`
# is the shared, checked-in detector config; everything else here is runtime scratch
# (live-server sessions, hook caches) and is machine-local.
breeding-app-public/.impeccable/
.impeccable/live/
.impeccable/hook.cache.json
**/.impeccable/hook.cache.json
