{
  "name": "breeding-app-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lab/genetic testing app extracted from the combined Breeding Planner repository.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:reset": "npm --prefix ../breeding-app-backend run e2e:reset:local && npm run test:e2e",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "build:android:dev": "vite build --mode android-development",
    "build:android:staging": "cross-env NODE_ENV=production vite build --mode android-staging",
    "build:android:prod": "cross-env NODE_ENV=production vite build --mode android-production",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:debug": "powershell -ExecutionPolicy Bypass -File scripts/android-build.ps1 -Environment production -Artifact apk -BuildType debug",
    "android:release:apk": "powershell -ExecutionPolicy Bypass -File scripts/android-build.ps1 -Environment production -Artifact apk -BuildType release"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.1",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "html5-qrcode": "^2.3.8",
    "i18next": "^25.6.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "jspdf": "^2.5.1",
    "qrcode": "^1.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.3.5",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^1.6.0"
  }
}
