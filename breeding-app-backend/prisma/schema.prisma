  active              Boolean         @default(true)
  visibleInBreederApp Boolean         @default(true)
  description         String?
  sortOrder           Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  offerings           LabTestOffering[]
}

// What a vendor laboratory actually sells, and the only test data a breeder
// ever sees once they have chosen a lab (2026-08-30 decision: labs define their
// own tests, fully).
//
// The relationship to ShedTestCatalog is deliberately weak. A lab may copy a
// standard test in from that library as a starting point — `catalogRefId` keeps
// the link so results stay comparable across labs and the genetics engine can
// map the gene — but a lab may equally invent a test that exists in no catalog.
// The library never gates what a lab is allowed to offer.
model LabTestOffering {
  id                  String          @id @default(cuid())
  organizationId      String          @map("organization_id")
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name                String
  shortLabel          String?         @map("short_label")
  category            String
  pricingType         TestPricingType @map("pricing_type")
  /** This lab's own price. Null means "priced by the tier table", not "free". */
  priceCents          Int?            @map("price_cents")
  currency            String          @default("EUR")
  /**
   * Gene this test reads, when the lab has mapped it. Drives the automatic
   * genetics update on a confirmed result; a custom test may leave it null and
   * simply reports a finding.
   */
  geneTarget          String?         @map("gene_target")
  /** Optional provenance link to the shared seed library. Never a constraint. */
  catalogRefId        String?         @map("catalog_ref_id")
  catalogRef          ShedTestCatalog? @relation(fields: [catalogRefId], references: [id], onDelete: SetNull)

  allowedPriorities   String[]        @default(["routine", "priority", "urgent"]) @map("allowed_priorities")
  turnaroundDays      Int?            @map("turnaround_days")
  active              Boolean         @default(true)
  visibleInBreederApp Boolean         @default(true) @map("visible_in_breeder_app")
  description         String?         @db.Text
  sortOrder           Int             @default(0) @map("sort_order")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  orderAnimalTests    ShedTestOrderAnimalTest[]

  // A lab cannot list the same name twice; across labs, duplicates are expected
  // and correct — two labs both offering "Albino" are two distinct products.
  @@unique([organizationId, name])
  @@index([organizationId, active])
  @@index([catalogRefId])
  @@map("lab_test_offerings")
}

// Tier multipliers, now owned by a lab rather than the platform.
//
// A row with `organizationId = null` is the platform *template*: it seeds a new
// vendor's config at invite acceptance and is never used to price an order. Order
// pricing always resolves the ordering lab's own row and fails loudly if it is
// missing, so a missing config can never silently fall back to someone else's
// prices.
model PricingConfig {
  id                             String   @id @default(cuid())
  organizationId                 String?  @unique @map("organization_id")
  organization                   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currency                       String   @default("EUR")
  morphTier1to9FirstTest         Decimal  @db.Decimal(10, 2)
  morphTier1to9AdditionalTest    Decimal  @db.Decimal(10, 2)
  morphTier10to49FirstTest       Decimal  @db.Decimal(10, 2)
  morphTier10to49AdditionalTest  Decimal  @db.Decimal(10, 2)
  morphTier50PlusFirstTest       Decimal  @db.Decimal(10, 2)
  morphTier50PlusAdditionalTest  Decimal  @db.Decimal(10, 2)
  sexTier1to9                    Decimal  @db.Decimal(10, 2)
  sexTier10to49                  Decimal  @db.Decimal(10, 2)
  sexTier50Plus                  Decimal  @db.Decimal(10, 2)
  isActive                       Boolean  @default(true)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

model ShedTestOrder {
  id                String                @id @default(cuid())
  orderNumber       String?               @unique
  /**
   * The lab the breeder chose at order time. Nullable only so the migration
   * could land against existing rows predating lab selection; every new order
   * sets it, and it is what every lab-side read filters on. Restrict, not
   * Cascade: deleting an organization must never silently delete a breeder's
   * order history.
   */
  labOrganizationId String?               @map("lab_organization_id")
  labOrganization   Organization?         @relation(fields: [labOrganizationId], references: [id], onDelete: Restrict)
  breederId         String
  // Cascade, not the Prisma default of Restrict: without this, deleting a user
  // who ever placed a lab order fails outright, which silently broke the
  // right-to-erasure flow. The order's own rows cascade from here.
  breeder           User                  @relation(fields: [breederId], references: [id], onDelete: Cascade)
  totalAnimals      Int
  pricingTier       PricingTier
  totalPrice        Decimal               @db.Decimal(12, 2)
  currency          String
  priceSnapshotJson Json
  status                ShedOrderStatus       @default(submitted)
  paymentStatus         ShedPaymentStatus     @default(pending)
  paymentRequestedAt    DateTime?
  paidAt                DateTime?
  paymentRef            String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  animals               ShedTestOrderAnimal[]
  results               ShedTestOrderResult[]

  @@index([breederId])
  @@index([status])
  @@index([labOrganizationId, status])
}

model ShedTestOrderAnimal {
  id                 String                  @id @default(cuid())
  orderId            String
  order              ShedTestOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  animalId           String
  animalName         String?
  morphBaseCost      Decimal                 @db.Decimal(10, 2)
  additionalMorphCost Decimal                @db.Decimal(10, 2)
  sexCost            Decimal                 @db.Decimal(10, 2)
  total              Decimal                 @db.Decimal(10, 2)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  tests              ShedTestOrderAnimalTest[]

  @@index([orderId])
}

model ShedTestOrderAnimalTest {
  id                  String             @id @default(cuid())
  orderAnimalId       String
  orderAnimal         ShedTestOrderAnimal @relation(fields: [orderAnimalId], references: [id], onDelete: Cascade)

  /**
   * The lab offering this line was bought from. Nullable and SetNull because a
   * lab may retire an offering years after an order shipped, and losing the
   * order line with it would be data loss — the snapshot columns below are what
   * make the historical record self-contained regardless.
   */
  offeringId          String?            @map("offering_id")
  offering            LabTestOffering?   @relation(fields: [offeringId], references: [id], onDelete: SetNull)

  /**
   * Legacy provenance: the global-catalog id this line used before tests became
   * lab-owned. Kept as a plain string with no foreign key so old orders stay
   * readable; new orders leave it null and use `offeringId`.
   */
  testId              String?
  testNameSnapshot    String
  pricingTypeSnapshot TestPricingType
  priceApplied        Decimal            @db.Decimal(10, 2)
  createdAt           DateTime           @default(now())

  @@index([orderAnimalId])
  @@index([offeringId])
}

model ShedTestOrderResult {
  id            String           @id @default(cuid())
  orderId       String
  order         ShedTestOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  animalId      String
  sampleId      String
  status        ShedResultStatus @default(running)
  testCode      String
  method        String?
  findingsJson  Json
  summary       String?
  reportedAt    DateTime?
  analystUserId String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([orderId, animalId, testCode])
  @@index([orderId])
  @@index([animalId])
  @@index([status])
}

// ── Reproductive Intelligence models ──────────────────────────
//
// One row per female per breeding season pairing.
// Ingested automatically from Pairing.payload on every snapshot save.
model ReproductiveCycle {
  id             String  @id @default(cuid())
  ownerId        String
  owner          User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Female identity (both DB id and app-local id for fast lookup)
  femaleAnimalId String
  femaleAppId    String

  // Male used this cycle (optional)
  maleAnimalId   String?
  maleAppId      String?

  // Source pairing
  pairingId      String?
  pairingAppId   String?

  season         Int    // year the pairing started
  cycleIndex     Int    // 1st, 2nd... cycle for this female in this season

  // Key reproductive dates (YYYY-MM-DD strings, matching existing payload convention)
  pairingStartDate  String?
  pairingEndDate    String?
  ovulationDate     String?
  preLayShedDate    String?
  eggLayingDate     String?

  // Clutch outcome
  eggCount       Int?
  fertileCount   Int?
  slugCount      Int?

  notes          String?  @db.Text
  payload        Json?    // extensible: follicle data, weight, future fields

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  locks          LockEvent[]

  @@unique([femaleAnimalId, season, cycleIndex])
  @@index([femaleAnimalId])
  @@index([ownerId])
  @@index([pairingId])
  @@map("reproductive_cycles")
}

// One row per confirmed lock event.
// Natural dedup key: (femaleAnimalId, lockDate) — prevents double-entry from
// calendar, log, snake card, etc.
model LockEvent {
  id             String  @id @default(cuid())
  ownerId        String
  femaleAnimalId String  // Animal.id (DB UUID)
  femaleAppId    String  // appAnimalId (frontend id)

  cycleId        String?
  cycle          ReproductiveCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  lockDate       String  // YYYY-MM-DD
  notes          String? @db.Text

  // Source attribution: where did this lock come from?
  sourceType     String  // 'pairing_calendar' | 'log' | 'snake_card' | 'import' | 'manual'
  sourceId       String? // appPairingId or other originating record id

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([femaleAnimalId, lockDate])
  @@index([femaleAnimalId])
  @@index([cycleId])
  @@index([ownerId])
  @@map("lock_events")
}

// Computed analytics cache — rebuilt after every cycle/lock write.
// Raw cycle + lock rows are source of truth; this is a read-optimization.
model ReproductiveAnalyticsCache {
  id                       String   @id @default(cuid())
  femaleAnimalId           String   @unique
  femaleAppId              String
  ownerId                  String

  totalCycles              Int      @default(0)
  avgLocksPerCycle         Decimal? @db.Decimal(6, 2)
  avgDaysBetweenLocks      Decimal? @db.Decimal(6, 2)
  avgFirstLockToOvulation  Decimal? @db.Decimal(6, 2)
  avgLastLockToOvulation   Decimal? @db.Decimal(6, 2)
  avgOvulationToPreLayShed Decimal? @db.Decimal(6, 2)
  avgPreLayShedToEggLaying Decimal? @db.Decimal(6, 2)
  avgOvulationToEggLaying  Decimal? @db.Decimal(6, 2)
  avgFertilityRate         Decimal? @db.Decimal(5, 4)

  // 'none' | 'low' | 'medium' | 'high'
  confidenceLevel          String   @default("none")
  // JSON string[] e.g. ["early_ovulator", "frequent_locker", "consistent"]
  patternTagsJson          Json?

  lastCalculatedAt         DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([ownerId])
  @@map("reproductive_analytics_cache")
}

// ── Family Tree models ──────────────────────────────────────

// role: "sire" | "dam"
// confidence: "confirmed" | "reported" | "unknown"
model ParentRelationship {
  id          String   @id @default(cuid())
  childId     String
  child       Animal   @relation("ChildOf",   fields: [childId],  references: [id], onDelete: Cascade)
  parentId    String
  parent      Animal   @relation("ParentOf",  fields: [parentId], references: [id], onDelete: Cascade)
  role        String
  confidence  String   @default("confirmed")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([childId, role])
  @@index([childId])
  @@index([parentId])
  @@map("parent_relationships")
}

// transferType: "bred" | "sale" | "gift" | "trade" | "breeding_loan"
model OwnershipHistory {
  id           String    @id @default(cuid())
  animalId     String
  animal       Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  ownerId      String
  ownerName    String?
  fromDate     DateTime
  toDate       DateTime?
  transferType String
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())

  @@index([animalId])
  @@index([ownerId])
  @@map("ownership_history")
}

// ── Email notification system ─────────────────────────────────────────────────
// status: pending | processing | provider_accepted | delivered | delivery_delayed
//       | failed | bounced | complained | suppressed | cancelled
model EmailJob {
  id                  String    @id @default(cuid())
  ownerId             String    @map("owner_id")
  owner               User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  recipientEmail      String    @map("recipient_email")
  category            String
  templateKey         String    @map("template_key")
  templateVersion     Int       @map("template_version")
  templatePayload     Json      @map("template_payload")
  subject             String
  scheduledFor        DateTime  @default(now()) @map("scheduled_for")
  status              String    @default("pending")
  attemptCount        Int       @default(0) @map("attempt_count")
  maximumAttempts     Int       @default(5) @map("maximum_attempts")
  nextAttemptAt       DateTime? @map("next_attempt_at")
  lastErrorCode       String?   @map("last_error_code")
  lastErrorMessage    String?   @map("last_error_message") @db.Text
  provider            String?
  providerMessageId   String?   @map("provider_message_id")
  idempotencyKey      String    @unique @map("idempotency_key")
  relatedEntityType   String?   @map("related_entity_type")
  relatedEntityId     String?   @map("related_entity_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  processingStartedAt DateTime? @map("processing_started_at")
  sentAt              DateTime? @map("sent_at")
  deliveredAt         DateTime? @map("delivered_at")
  failedAt            DateTime? @map("failed_at")
  cancelledAt         DateTime? @map("cancelled_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  events              EmailEvent[]

  @@index([ownerId])
  @@index([status, nextAttemptAt])
  @@index([status, scheduledFor])
  @@index([providerMessageId])
  @@index([relatedEntityType, relatedEntityId])
  @@map("email_jobs")
}

// type: sent | delivered | delivery_delayed | bounced | complained | failed
model EmailEvent {
  id              String   @id @default(cuid())
  emailJobId      String   @map("email_job_id")
  emailJob        EmailJob @relation(fields: [emailJobId], references: [id], onDelete: Cascade)
  providerEventId String?  @unique @map("provider_event_id")
  type            String
  occurredAt      DateTime @map("occurred_at")
  rawSummary      Json?    @map("raw_summary")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([emailJobId])
  @@map("email_events")
}

// category: account_and_security | organization_invitations | breeding_reminders
//         | incubation_reminders | unexpected_breeding_events | weekly_summary | product_updates
model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        String
  enabled         Boolean  @default(true)
  timezone        String   @default("UTC")
  leadTimeMinutes Int?     @map("lead_time_minutes")
  digest          String   @default("immediate")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([userId, category])
  @@index([userId])
  @@map("notification_preferences")
}

// reason: hard_bounce | complaint | unsubscribe | admin
model EmailSuppression {
  id           String    @id @default(cuid())
  emailAddress String    @unique @map("email_address")
  reason       String
  source       String
  createdAt    DateTime  @default(now()) @map("created_at")
  releasedAt   DateTime? @map("released_at")
  releasedBy   String?   @map("released_by")

  @@map("email_suppressions")
}
