generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  lab
  breeder
  buyer
  moderator
  support
}

// Distinguishes the two kinds of tenant, which come into existence through
// entirely different doors: `breeder` orgs are created automatically at public
// signup, `lab_vendor` orgs only ever via an admin invitation (there is
// deliberately no public signup path for the Lab Portal). See
// docs/architecture/saas-implementation-plan.md §3.1/§3.3.
enum OrganizationKind {
  breeder
  lab_vendor
}

// Org-scoped role, distinct from the global `UserRole` above. `UserRole` says
// what kind of user someone is platform-wide (breeder/lab/admin/...);
// `OrgRole` says what they may do inside their own organization.
enum OrgRole {
  owner
  admin
  billing_manager
  member
}

enum TestPricingType {
  morph
  sex
}

enum PricingTier {
  tier_1_9
  tier_10_49
  tier_50_plus
}

enum ShedOrderStatus {
  submitted
  received
  in_progress
  completed
  cancelled
}

enum ShedPaymentStatus {
  pending
  invoiced
  paid
  waived
}

enum ShedResultStatus {
  running
  completed
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  passwordHash     String
  fullName         String
  role             UserRole
  isActive         Boolean        @default(true)
  emailVerified    Boolean        @default(false)
  emailVerifiedAt  DateTime?
  pendingEmail     String?
  pendingEmailRequestedAt DateTime?
  passwordChangedAt DateTime?
  status           String         @default("active")
  verificationStatus String       @default("not_applied")
  subscriptionPlan String         @default("free")
  subscriptionStatus String         @default("inactive")
  subscriptionStartedAt DateTime?
  subscriptionRenewalAt DateTime?
  subscriptionTrialEndsAt DateTime?
  subscriptionPaymentStatus String @default("none")
  lastLoginAt           DateTime?
  // Right-to-erasure grace period. `status` becomes "pending_deletion" and the
  // account is locked immediately; the purge job hard-deletes once
  // deletionScheduledAt passes. Signing in during the window cancels it and
  // clears both columns.
  deletionRequestedAt   DateTime?      @map("deletion_requested_at")
  deletionScheduledAt   DateTime?      @map("deletion_scheduled_at")
  refreshToken          String?        @db.Text
  // Deprecated: superseded by AccountToken (purpose "reset_password"). Columns kept, no longer written.
  passwordResetToken    String?        @unique
  passwordResetExpiry   DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  profile          Profile?
  orders           ShedTestOrder[]
  animals          Animal[]
  pairings         Pairing[]
  clutches         Clutch[]
  plannerState     BreederPlannerState?
  listings         Listing[]
  inquiriesSent    ListingInquiry[] @relation("ListingInquiryBuyer")
  inquiriesReceived ListingInquiry[] @relation("ListingInquiryBreeder")
  savedSearches    SavedSearch[]
  notifications     Notification[] @relation("NotificationRecipient")
  notificationsSent Notification[] @relation("NotificationActor")
  listingModerationAudits ListingModerationAudit[]
  adminAuditActions AdminAuditLog[] @relation("AdminAuditActor")
  targetAuditActions AdminAuditLog[] @relation("AdminAuditTarget")
  reportsFiled     Report[] @relation("ReportReporter")
  reportsReceived  Report[] @relation("ReportReportedUser")
  reportsAssigned  Report[] @relation("ReportAssignedAdmin")
  verificationRequests VerificationRequest[] @relation("VerificationRequestUser")
  verificationReviews  VerificationRequest[] @relation("VerificationRequestReviewer")
  marketplacePermission MarketplacePermission?
  labAccount       LabAccount?
  reviewedPartnerApplications PartnerApplication[] @relation("PartnerApplicationReviewer")
  gdprRequests     GdprRequest[] @relation("GdprRequestUser")
  gdprReviews      GdprRequest[] @relation("GdprRequestReviewer")
  subscriptions     UserSubscription[] @relation("UserSubscriptionUser")
  featureOverrides  UserFeatureOverride[] @relation("UserFeatureOverrideUser")
  featureOverridesCreated UserFeatureOverride[] @relation("UserFeatureOverrideAdmin")
  usageTracking     UsageTracking[]
  marketplaceListings MarketplaceListing[] @relation("MarketplaceListingSeller")
  marketplaceStores MarketplaceStore[]
  marketplaceMessages MarketplaceMessage[] @relation("MarketplaceMessageSender")
  marketplaceBuyerConversations MarketplaceConversation[] @relation("MarketplaceConversationBuyer")
  marketplaceSellerConversations MarketplaceConversation[] @relation("MarketplaceConversationSeller")
  marketplaceFavorites MarketplaceFavorite[]
  marketplaceBuyerSales MarketplaceSale[] @relation("MarketplaceSaleBuyer")
  marketplaceSellerSales MarketplaceSale[] @relation("MarketplaceSaleSeller")
  marketplaceReviews MarketplaceReview[] @relation("MarketplaceReviewReviewer")
  marketplaceSellerReviews MarketplaceReview[] @relation("MarketplaceReviewSeller")
  mobileScanLogs   MobileScanLog[]
  mobileSyncQueue  MobileSyncQueue[]
  deviceSessions   UserDeviceSession[]
  refreshSessions  RefreshSession[]
  securityEvents   SecurityEvent[]
  reproductiveCycles ReproductiveCycle[]
  marketplaceMedia MarketplaceMedia[] @relation("MarketplaceMediaOwner")
  marketplaceMessageReports MarketplaceMessageReport[] @relation("MarketplaceMessageReportReporter")
  marketplaceBlocks MarketplaceUserBlock[] @relation("MarketplaceUserBlockBlocker")
  marketplaceBlockedBy MarketplaceUserBlock[] @relation("MarketplaceUserBlockBlocked")
  emailJobs          EmailJob[]
  notificationPreferences NotificationPreference[]
  accountTokens      AccountToken[]
  // Singular, not a list: one organization per user is a hard rule enforced by
  // Membership.userId @unique (see the Membership model).
  membership         Membership?
  organizationInvitesSent     OrganizationInvite[] @relation("OrganizationInviteInviter")
  organizationInvitesAccepted OrganizationInvite[] @relation("OrganizationInviteAcceptedBy")

  @@index([deletionScheduledAt])
}

// The tenant: a breeding business or an admin-vetted vendor lab. Sits *above*
// User — existing per-user `ownerId`/`userId` ownership on scoped models stays
// as "who created this", while the org is what access is granted against.
//
// Billing note: only `breeder` orgs are ever billed. `lab_vendor` orgs are free
// for admin-vetted service partners and skip the checkout/paywall path
// entirely (decided 2026-07-30, see implementation plan §4).
model Organization {
  id              String           @id @default(cuid())
  name            String
  kind            OrganizationKind
  // active | suspended. Suspension is how an admin revokes a vendor lab's
  // access without deleting its data.
  status          String           @default("active")
  billingEmail    String?          @map("billing_email")
  suspendedAt     DateTime?        @map("suspended_at")
  suspendedReason String?          @map("suspended_reason") @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  memberships   Membership[]
  invites       OrganizationInvite[]
  labAccount    LabAccount?
  testOfferings LabTestOffering[]
  pricingConfig PricingConfig?
  labOrders     ShedTestOrder[]

  @@index([kind])
  @@index([status])
  @@map("organizations")
}

// User <-> Organization join, carrying the org-scoped role.
//
// `userId` is deliberately @unique: one organization per user is a hard product
// rule, not an incidental constraint (decided 2026-07-30, see implementation
// plan §3.1). Encoding it at the DB level makes the rule structurally
// impossible to violate, and means there is no "active org" / org-switcher
// concept anywhere in the system. A technician working for two vendor labs
// needs two accounts. Relaxing this later is a migration project in its own
// right, not an incremental change — every permission check assumes it.
model Membership {
  id             String       @id @default(cuid())
  userId         String       @unique @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(member)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([role])
  @@map("memberships")
}

// One entity, two distinct triggers (see implementation plan §3.1):
//
//  1. Teammate invite — `organizationId` is set: an existing org's owner/admin
//     invites someone into that org. Accepting creates a Membership only.
//  2. New-vendor invite — `organizationId` is null and `createsOrgKind` is set:
//     the platform admin invites a brand-new vendor lab. Accepting *creates the
//     organization* plus an `owner` Membership. This is the only way a
//     lab_vendor org ever comes into existence.
//
// A laboratory asking to be considered as a partner.
//
// Onboarding stays invitation-only: this creates no account, no organization
// and no access whatsoever. It is a lead for an administrator to read, and its
// only outcome is that the administrator decides to send a real invitation — or
// does not. Without it a laboratory that hears about the platform has no way to
// raise its hand at all, which is a gap in the journey rather than a hole in
// the rule.
model PartnerApplication {
  id             String    @id @default(cuid())
  labName        String    @map("lab_name")
  contactName    String    @map("contact_name")
  email          String
  phone          String?
  country        String?
  website        String?
  /** Free text: what they test, their capacity, why they want to join. */
  message        String?   @db.Text

  // pending | invited | declined
  status         String    @default("pending")
  reviewedBy     String?   @map("reviewed_by")
  reviewer       User?     @relation("PartnerApplicationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt     DateTime? @map("reviewed_at")
  /** Why it was declined, or which invitation it became. Admin-only. */
  reviewNote     String?   @map("review_note") @db.Text

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([email])
  @@map("partner_applications")
}

// Distinct from AccountToken (account lifecycle: verify email, reset password)
// and from the existing internal-staff invite flow, which stays scoped to
// internal ops accounts and does not create tenant orgs.
model OrganizationInvite {
  id             String            @id @default(cuid())
  email          String
  // sha256 of the raw token, never the token itself — same scheme as
  // AccountToken/RefreshSession (see accountTokenService.hashToken).
  tokenHash      String            @unique @map("token_hash")
  organizationId String?           @map("organization_id")
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Set only for trigger 2 above; the org to create on acceptance.
  createsOrgKind OrganizationKind? @map("creates_org_kind")
  createsOrgName String?           @map("creates_org_name")
  // Prefill for the LabAccount created on acceptance, so a vendor does not have
  // to retype details the inviting admin already supplied. Vendor-editable after.
  createsOrgLocation String?       @map("creates_org_location")
  createsOrgContact  String?       @map("creates_org_contact")
  // Role the invitee receives. Trigger 2 always grants `owner`.
  role           OrgRole           @default(member)
  invitedBy      String?           @map("invited_by")
  inviter        User?             @relation("OrganizationInviteInviter", fields: [invitedBy], references: [id], onDelete: SetNull)
  // pending | accepted | revoked
  status         String            @default("pending")
  expiresAt      DateTime          @map("expires_at")
  acceptedAt     DateTime?         @map("accepted_at")
  acceptedByUserId String?         @map("accepted_by_user_id")
  acceptedBy     User?             @relation("OrganizationInviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@map("organization_invites")
}

// purpose: verify_email | reset_password | verify_new_email
model AccountToken {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose      String
  tokenHash    String    @unique @map("token_hash")
  emailAddress String    @map("email_address")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String    @default("self") @map("created_by")

  @@index([userId, purpose])
  @@map("account_tokens")
}

model RefreshSession {
  id                  String    @id @default(cuid())
  userId              String    @map("user_id")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique @map("token_hash") @db.Text
  deviceName          String?   @map("device_name")
  ipHash              String?   @map("ip_hash")
  userAgent           String?   @map("user_agent") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at")
  lastUsedAt          DateTime? @map("last_used_at")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedBySessionId String?   @map("replaced_by_session_id")

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_sessions")
}

model SecurityEvent {
  id          String   @id @default(cuid())
  type        String
  actorUserId String?  @map("actor_user_id")
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  outcome     String   @default("success")
  reason      String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([type])
  @@index([actorUserId])
  @@index([outcome])
  @@index([createdAt])
  @@map("security_events")
}

model Profile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  breederName          String?
  logoUrl              String?
  profileImageUrl      String?
  location             String?
  country              String?
  city                 String?
  language             String?
  bio                  String?  @db.Text
  websiteUrl           String?
  instagramHandle      String?
  facebookHandle       String?
  telegramHandle       String?
  socialLinks          Json?
  publicContactEmail   String?
  publicContactPhone   String?
  contactPreference    String?  @default("email")
  isPublic             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

model Animal {
  id           String    @id @default(cuid())
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  appAnimalId  String
  name         String?
  sex          String?
  status       String?
  payload      Json
  globalId     String?
  privacyLevel String    @default("private")
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  asChild      ParentRelationship[] @relation("ChildOf")
  asParent     ParentRelationship[] @relation("ParentOf")
  ownershipHistory OwnershipHistory[]

  @@unique([ownerId, appAnimalId])
  @@index([ownerId])
  @@index([ownerId, updatedAt])
  @@index([globalId])
}

model Pairing {
  id                String    @id @default(cuid())
  ownerId           String
  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  appPairingId      String
  label             String?
  maleAnimalAppId   String?
  femaleAnimalAppId String?
  status            String?
  workflowStatus    String?   @map("workflow_status")
  completionReason  String?   @map("completion_reason")
  outcomeConfidence String?   @map("outcome_confidence")
  completedAt       DateTime? @map("completed_at")
  completedByUserId String?   @map("completed_by_user_id")
  completionNote    String?   @map("completion_note") @db.Text
  reopenedAt        DateTime? @map("reopened_at")
  reopenedByUserId  String?   @map("reopened_by_user_id")
  startDate         String?
  payload           Json
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  clutches          Clutch[]

  @@unique([ownerId, appPairingId])
  @@index([ownerId])
  @@index([ownerId, updatedAt])
  @@index([ownerId, status])
  @@index([ownerId, workflowStatus])
  @@index([ownerId, completionReason])
  @@index([completedAt])
}

model Clutch {
  id            String    @id @default(cuid())
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  pairingId     String?
  pairing       Pairing?  @relation(fields: [pairingId], references: [id], onDelete: SetNull)
  appClutchId   String
  clutchNumber  Int?
  seasonYear    Int?
  laidDate      String?
  payload       Json
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([ownerId, appClutchId])
  @@index([ownerId])
  @@index([ownerId, updatedAt])
  @@index([pairingId])
}

model BreederPlannerState {
  id        String   @id @default(cuid())
  ownerId   String   @unique
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("breeder_planner_states")
}

model Listing {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  appListingId String
  animalAppId  String?
  title        String?
  status       String   @default("draft")
  priceCents   Int?
  currency     String   @default("EUR")
  payload      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  inquiries    ListingInquiry[]
  moderationAudits ListingModerationAudit[]
  reports      Report[]

  @@unique([ownerId, appListingId])
  @@index([ownerId])
  @@index([status])
  @@index([ownerId, status])
}

model ListingInquiry {
  id            String   @id @default(cuid())
  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  breederId     String
  breeder       User     @relation("ListingInquiryBreeder", fields: [breederId], references: [id], onDelete: Cascade)
  buyerId       String?
  buyer         User?    @relation("ListingInquiryBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  buyerName     String
  buyerEmail    String
  message       String   @db.Text
  status        String   @default("new")
  breederResponseNote String?  @db.Text
  respondedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([listingId])
  @@index([breederId])
  @@index([buyerId])
  @@index([status])
}

model SavedSearch {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([ownerId, updatedAt])
}

model Notification {
  id          String    @id @default(cuid())
  recipientId String
  recipient   User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type        String
  title       String
  message     String    @db.Text
  metadata    Json?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId])
  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

model ListingModerationAudit {
  id             String   @id @default(cuid())
  listingId      String
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  previousStatus String
  newStatus      String
  note           String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([listingId])
  @@index([actorId])
  @@index([createdAt])
}

model AdminAuditLog {
  id            String   @id @default(cuid())
  adminUserId   String?
  adminUser     User?    @relation("AdminAuditActor", fields: [adminUserId], references: [id], onDelete: SetNull)
  targetUserId  String?
  targetUser    User?    @relation("AdminAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  action        String
  beforeJson    Json?
  afterJson     Json?
  reason        String
  internalNote  String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

model Report {
  id               String   @id @default(cuid())
  reporterUserId   String?
  reporterUser     User?    @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  reportedUserId   String?
  reportedUser     User?    @relation("ReportReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  relatedListingId String?
  relatedListing   Listing? @relation(fields: [relatedListingId], references: [id], onDelete: SetNull)
  relatedMessageId String?
  type             String
  status           String   @default("open")
  description      String   @db.Text
  assignedAdminId  String?
  assignedAdmin    User?    @relation("ReportAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  resolutionNote   String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([reporterUserId])
  @@index([reportedUserId])
  @@index([relatedListingId])
  @@index([assignedAdminId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model VerificationRequest {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation("VerificationRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  type              String   @default("breeder")
  status            String   @default("pending_review")
  submittedDataJson Json
  adminNote         String?  @db.Text
  reviewedBy        String?
  reviewer          User?    @relation("VerificationRequestReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([reviewedBy])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model MarketplacePermission {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  canAccess         Boolean  @default(true)
  activeListingLimit Int     @default(25)
  requireApproval   Boolean @default(false)
  featuredBreeder   Boolean @default(false)
  disabledReason    String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([canAccess])
  @@index([featuredBreeder])
}

// Owned by an Organization as of the Phase 1 tenancy migration. This is what
// fixes the concretely-broken case the audit called out: a vendor lab with more
// than one employee. Access to lab features is granted by *org membership*, so
// any number of staff can work under one LabAccount.
//
// `userId` is retained (and still unique) as the designated owning user — the
// person the admin originally invited. It is not the access-control mechanism
// any more; org membership is. Keeping it preserves the existing admin-panel
// search (which filters through the `user` relation) and response shape.
// Given one-org-per-user plus one-LabAccount-per-org, userId being unique is
// implied anyway, so the constraint costs nothing and avoids needless churn.
model LabAccount {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId    String   @unique @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  labName           String
  contactPerson     String?
  location          String?
  status            String   @default("pending")
  permissionsJson   Json
  availableTestsJson Json
  pricingJson       Json

  // ── Per-tenant identity ──────────────────────────────────────
  //
  // Every one of these used to be a hardcoded constant (LAB_PROFILE in
  // labelProfileService.ts, plus a committed logo image), which meant every
  // vendor's shipping labels and certificates went out branded as the single
  // lab the feature was first built for. These are what the documents render
  // from now, resolved per order via the order's owning lab.
  contactEmail      String?  @map("contact_email")
  phone             String?
  addressLine1      String?  @map("address_line1")
  addressLine2      String?  @map("address_line2")
  city              String?
  postalCode        String?  @map("postal_code")
  country           String?
  /** Data URI or hosted URL, rendered onto certificates. */
  logoUrl           String?  @map("logo_url") @db.Text
  /** Free text shown to breeders choosing a lab. */
  publicDescription String?  @map("public_description") @db.Text
  /** Typical turnaround in days, shown in the lab directory. */
  turnaroundDays    Int?     @map("turnaround_days")
  /**
   * Payment details printed on the certificates this laboratory issues. Held
   * per-laboratory for the same reason as the address: they used to be a
   * hardcoded constant belonging to one specific lab, and every certificate
   * carried that lab's bank account whoever ran the test.
   */
  iban              String?
  bic               String?
  vatNumber         String?  @map("vat_number")
  /**
   * Whether breeders may discover and order from this lab. Vendor-controlled —
   * a lab closing for holidays hides itself without an admin round-trip. An
   * admin suspending the Organization overrides this independently.
   */
  listedInDirectory Boolean  @default(true) @map("listed_in_directory")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([listedInDirectory])
}

