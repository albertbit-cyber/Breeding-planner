PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176"
APP_PUBLIC_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Public base URL for this app, used to build links in transactional emails.
# Must be a trusted configured value — never derived from request headers.
PUBLIC_APP_URL="http://localhost:5173"

# --- Email (Resend) ---------------------------------------------------------
# Leave EMAIL_ENABLED=false for local development and tests; the mock provider
# is used automatically and no real email is ever sent.
EMAIL_ENABLED=false
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM_NAME="Serpentora"
EMAIL_FROM_ADDRESS="notifications@serpentora.com"
EMAIL_REPLY_TO="support@serpentora.com"
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_POLL_INTERVAL_MS=15000
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_STUCK_JOB_MINUTES=10

# --- Error tracking (Sentry) -------------------------------------------------
# Leave SENTRY_DSN empty to disable — error tracking is a no-op without it.
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Same-origin auth proxy (Phase 0.5, see saas-implementation-plan.md) ----
# "lax" is correct once every frontend reaches this backend through a
# same-origin proxy. Only set to "none" for an environment that still talks
# to the backend cross-origin and needs cookie auth to keep working during
# the rollout — bearer-token auth (the default everywhere today) is
# unaffected either way.
AUTH_COOKIE_SAMESITE="lax"
