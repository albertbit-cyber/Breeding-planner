PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176"
APP_PUBLIC_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Public base URL for this app, used to build links in transactional emails.
# Must be a trusted configured value — never derived from request headers.
# Set this explicitly: when unset it falls back to the first CORS_ORIGIN entry,
# which produces verification links pointing at the wrong dev port if your Vite
# server is not on 5173.
PUBLIC_APP_URL="http://localhost:5173"

# --- Email -------------------------------------------------------------------
# EMAIL_ENABLED=false means the in-memory MOCK provider is used and NO MAIL IS
# EVER SENT — queued jobs are marked "sent" and thrown away. The boot log says
# so explicitly ("[mail] NO TRANSPORT CONFIGURED"), and outside production the
# worker prints verification/reset links to the console so local signup still
# works. That is the intended default for automated tests.
#
# For local development, prefer a real SMTP catch-all so you see the actual
# rendered email. Mailpit accepts everything and never forwards:
#
#     docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
#
# then set: EMAIL_ENABLED=true, EMAIL_PROVIDER="smtp", SMTP_HOST=localhost,
# SMTP_PORT=1025 — and read the mail at http://localhost:8025
EMAIL_ENABLED=false
# "resend" | "smtp"  (anything else falls back to the mock provider)
EMAIL_PROVIDER="resend"

# --- Email: Resend -----------------------------------------------------------
# Test-mode limitation: until your sending domain is verified in the Resend
# dashboard, Resend will only deliver to the email address that owns the
# account. Sends to any other recipient are rejected — they are NOT silently
# dropped, so they appear in the log as a permanent "[mail] send failed".
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""

# --- Email: SMTP -------------------------------------------------------------
# Local Mailpit (see above) needs only SMTP_HOST/SMTP_PORT — no credentials.
#
# Gmail SMTP requires a 16-character App Password (Google Account > Security >
# 2-Step Verification > App passwords), NOT your normal account password, and
# 2FA must be enabled for that option to exist. Use port 587 (STARTTLS,
# SMTP_SECURE=false) or port 465 (implicit SSL, SMTP_SECURE=true).
SMTP_HOST=""
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
# Defaults to true only when SMTP_PORT=465; leave unset otherwise.
SMTP_SECURE=""
EMAIL_FROM_NAME="Serpentora"
EMAIL_FROM_ADDRESS="notifications@serpentora.com"
EMAIL_REPLY_TO="support@serpentora.com"
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_POLL_INTERVAL_MS=15000
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_STUCK_JOB_MINUTES=10

# --- Error tracking (Sentry) -------------------------------------------------
# Leave SENTRY_DSN empty to disable — error tracking is a no-op without it.
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Same-origin auth proxy (Phase 0.5, see saas-implementation-plan.md) ----
# "lax" is correct once every frontend reaches this backend through a
# same-origin proxy. Only set to "none" for an environment that still talks
# to the backend cross-origin and needs cookie auth to keep working during
# the rollout — bearer-token auth (the default everywhere today) is
# unaffected either way.
AUTH_COOKIE_SAMESITE="lax"
